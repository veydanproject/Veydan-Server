#!/usr/bin/env bash
# veydan-server: the server after the installer. Put in /usr/local/bin by
# components/base.sh; the kit it runs is the one that installed this server
# (/opt/veydan/kit/current).
#
#   veydan-server show            the card: addresses, keys, where things are
#   veydan-server join-token      the key a new server of this network pastes
#   veydan-server add <component> adds relay, media, vpush or call here
#   veydan-server status          the services of this server
#   veydan-server rerun           the installer again, with the saved answers
#   veydan-server card [--invite <code>] [--contact <npub>]
#                                 the link the app takes to add this server
#                                 (--invite: with an invite of a team or channel
#                                 server; --contact: a link to a contact with it)
#   veydan-server push veydan|off wake phones through the push of the Veydan network
#   veydan-server media-key required|open  uploads to media need the key of the server, or not
#   veydan-server upload-key <label> <pubkey> [days]  an upload key of one person
#                                 for the media of this server (30 days, at most 31)
#   veydan-server upload-key revoke <label> <pubkey>  ends the upload keys of the pair
#   veydan-server upload-key list the revoked pairs
#   veydan-server mode [open|team|channel]  who uses the relay (ACCESS_MODE)
#   veydan-server invite [--uses N] [--days D] [--label L]  an invite to a team
#                                 or channel server: the card that carries it
#                                 (1 use, 7 days by default)
#   veydan-server invite list | revoke <id>  the invites, or end one
#   veydan-server members list | add <npub|hex> | remove <npub|hex>
set -euo pipefail

STATE=${VEYDAN_STATE:-/opt/veydan}
CONF=$STATE/server.conf
G=/opt/vguard

die() { printf '\033[1;31mxx\033[0m %s\n' "$*" >&2; exit 1; }
need_root() { [ "$(id -u)" = 0 ] || die "run as root"; }
kit() {
    local k=$STATE/kit/current
    [ -f "$k/run.sh" ] || die "no kit at $k: run install.sh once"
    printf '%s' "$k"
}

# The card of the server as a link:
#   veydan://server/<id>?u=…&k=…[&m=…][&c=…][&pu=…]&p=…&n=…[&a=team|channel][&inv=<code>]
# <id> is the first 16 hex of the sha256 of the relay URL (lowercase, no
# trailing slash), so the app knows the same server from any card of it.
# Values are percent-encoded. Only a server with a relay has a card. a=:
# the access mode, only when it is not open (the card of an open server is
# as it was); inv=: an invite of vguard (server_link <code>).
server_link() {
    local json=$STATE/manifest-node.json invite=${1:-}
    [ -r "$CONF" ] || { echo "no $CONF, or not readable: run install.sh once, as root" >&2; return 1; }
    (
        # shellcheck disable=SC1090
        . "$CONF"
        uri() { jq -rn --arg v "$1" '$v | @uri'; }
        # This server's own names, formed as run.sh does (fqdn of lib/common.sh);
        # the manifest lists the whole network, so it is not read for them.
        fqdn() { case "$1" in *.*) printf '%s' "$1" ;; *) printf '%s.%s' "$1" "${BASE_DOMAIN:-}" ;; esac; }
        has() { [[ " ${COMPONENTS:-} " == *" $1 "* ]]; }
        has relay && [ -n "${RELAY_HOST:-}" ] || { echo "this server has no relay: nothing to put on a card" >&2; exit 1; }
        url=wss://$(fqdn "$RELAY_HOST")
        url=$(printf '%s' "$url" | tr 'A-Z' 'a-z')
        id=$(printf '%s' "$url" | sha256sum | cut -c1-16)
        media=""
        if has media && [ -n "${MEDIA_HOST:-}" ]; then media=https://$(fqdn "$MEDIA_HOST"); media=$(printf '%s' "$media" | tr 'A-Z' 'a-z'); fi
        # The node of this server: its own manifest-node.json.
        call=""
        if has call && [ -r "$json" ]; then call=$(jq -r '.manifest.calls[0].ref // empty' "$json"); fi
        q="u=$(uri "$url")&k=$(uri "${MESH_APP_KEY:-}")"
        [ -z "$media" ] || q+="&m=$(uri "$media")"
        [ -z "$call" ] || q+="&c=$(uri "$call")"
        # The push server of this server: a phone registers at it through the
        # gateway (the app reads it as the push server of the card).
        if has vpush && [ -n "${VPUSH_HOST:-}" ]; then
            push=https://$(fqdn "$VPUSH_HOST"); push=$(printf '%s' "$push" | tr 'A-Z' 'a-z')
            q+="&pu=$(uri "$push")"
        fi
        q+="&p=$(uri "${PUSH_GATEWAY:-off}")&n=$(uri "${NETWORK:-}")"
        [ "${ACCESS_MODE:-open}" = open ] || q+="&a=$(uri "$ACCESS_MODE")"
        [ -z "$invite" ] || q+="&inv=$(uri "$invite")"
        printf 'veydan://server/%s?%s\n' "$id" "$q"
    )
}

# A server with media whose uploads are open (installed before the setting
# existed, or set so): said on stderr, in the language of the admin when the
# kit has it. The text is M[warn_media_open] of the kit's lang files.
media_open_warning() {
    (
        # shellcheck disable=SC1090
        . "$CONF" 2>/dev/null || exit 0
        [[ " ${COMPONENTS:-} " == *" media "* ]] || exit 0
        [ "${MEDIA_UPLOAD_KEY:-open}" = open ] || exit 0
        text="media: uploads are open to anyone with a nostr key (MEDIA_UPLOAD_KEY=open); a private server should set MEDIA_UPLOAD_KEY=required in server.conf and rerun"
        declare -A M
        l=$STATE/kit/current/lang
        if [ -f "$l/en.sh" ]; then
            # shellcheck disable=SC1090
            . "$l/en.sh"
            case "${LC_ALL:-${LANG:-}}" in ru*) [ -f "$l/ru.sh" ] && . "$l/ru.sh" ;; esac
            text=${M[warn_media_open]:-$text}
        fi
        printf '\033[1;33m!!\033[0m %s\n' "$text" >&2
    ) || true
}

# A setting of this server in server.conf: the line rewritten, or added
# (a conf of an older install has none).
set_conf() { # set_conf <NAME> <value>
    [ -w "$CONF" ] || die "no $CONF, or not writable: run install.sh once, as root"
    if grep -q "^$1=" "$CONF"; then
        sed -i "s/^$1=.*/$1=$2/" "$CONF"
    else
        printf '%s=%s\n' "$1" "$2" >> "$CONF"
    fi
}

# The access mode of the relay (ACCESS_MODE of server.conf): open when the
# conf has none (a server installed before the setting).
access_mode() {
    ( # shellcheck disable=SC1090
      . "$CONF" 2>/dev/null; printf '%s' "${ACCESS_MODE:-open}" )
}
# What touches the members and invites needs a relay that is not open.
need_access() {
    [ -r "$CONF" ] || die "no $CONF, or not readable: run install.sh once, as root"
    conf_has relay || die "this server has no relay: members and invites are the relay's (vguard)"
    [ "$(access_mode)" != open ] \
        || die "this server is open (ACCESS_MODE=open): anyone who has its card uses it, and there are no members or invites. veydan-server mode team (or channel), then veydan-server rerun"
}
# The CLI of vguard, as the user vguard (it writes the files of data/).
# VEYDAN_VGUARD: a program in its place, for the tests (then no HUP).
guard() {
    if [ -n "${VEYDAN_VGUARD:-}" ]; then
        "$VEYDAN_VGUARD" access --config "$G/etc/vguard.toml" "$@"
    else
        need_root
        runuser -u vguard -- "$G/bin/vguard" access --config "$G/etc/vguard.toml" "$@"
    fi
}
# The running vguard reads the files again (it would within a minute anyway).
guard_reload() {
    [ -z "${VEYDAN_VGUARD:-}" ] || return 0
    systemctl reload vguard || echo "vguard did not take the signal: it reads the files again within a minute" >&2
}
invite_re='^vi1\.[A-Za-z0-9_-]{1,128}\.[A-Za-z0-9_-]{1,128}$'
key_re='^(npub1[02-9ac-hj-np-z]{58}|[0-9a-f]{64})$'

# Whether the server has a component: in COMPONENTS of server.conf, or, for
# vpush, installed in /opt/vpush.
conf_has() {
    [ "$1" != vpush ] || [ ! -d /opt/vpush ] || return 0
    ( # shellcheck disable=SC1090
      . "$CONF" 2>/dev/null; [[ " ${COMPONENTS:-} " == *" $1 "* ]] )
}
# A card with p=veydan and no push address (pu=): this server has no vpush,
# and the app registers nothing.
push_hint() {
    case "$1" in *"&p=veydan"*) ;; *) return 0 ;; esac
    case "$1" in *"&pu="*) return 0 ;; esac
    conf_has vpush && return 0
    echo "card: p=veydan, but this server has no vpush and the card has no push address: veydan-server add vpush" >&2
}

case "${1:-}" in
    show)
        need_root
        [ -f "$STATE/server.txt" ] || die "no $STATE/server.txt: run install.sh once"
        cat "$STATE/server.txt"
        ;;
    join-token)
        # The network part of server.conf, one line of base64 behind a
        # prefix that names the format. It holds the keys of the network:
        # give it to the admin of the next server and to nobody else. (The
        # file is root's: that is the check.)
        [ -r "$CONF" ] || die "no $CONF, or not readable: run install.sh once, as root"
        net=$(sed -n '/^# ---- the network$/,/^# ---- this server$/p' "$CONF" | grep -v '^#')
        [ -n "$net" ] || die "$CONF has no network part"
        printf 'veydan-join-1.%s\n' "$(printf '%s\n' "$net" | base64 -w0)"
        ;;
    card)
        contact="" invite=""
        shift
        while [ $# -gt 0 ]; do
            case "$1" in
                --contact)
                    contact=${2:-}
                    [[ "$contact" =~ ^npub1[02-9ac-hj-np-z]{20,}$ ]] || die "veydan-server card --contact <npub>"
                    shift 2 ;;
                --invite)
                    invite=${2:-}
                    [[ "$invite" =~ $invite_re ]] || die "veydan-server card --invite <code>: the code of veydan-server invite (vi1.<id>.<mac>)"
                    need_access
                    shift 2 ;;
                *) die "veydan-server card [--invite <code>] [--contact <npub>]" ;;
            esac
        done
        link=$(server_link "$invite") || exit 1
        media_open_warning
        push_hint "$link"
        if [ -n "$contact" ]; then
            # base64url without padding, as the app reads it.
            printf 'veydan://contact/%s?srv=%s\n' "$contact" "$(printf '%s' "$link" | base64 -w0 | tr '+/' '-_' | tr -d '=')"
        else
            printf '%s\n' "$link"
        fi
        ;;
    push)
        # Stored in server.conf and shown on the card (p=); vpush of this
        # server is set to wake phones through the gateway, or not, at the
        # next run of the kit (components/vpush.sh).
        case "${2:-}" in veydan|off) ;; *) die "veydan-server push veydan|off" ;; esac
        set_conf PUSH_GATEWAY "$2"
        echo "push: $2 in $CONF; vpush takes it at the next run of the kit: veydan-server rerun" >&2
        link=$(server_link) || exit 1
        if [ "$2" = veydan ] && ! conf_has vpush; then
            echo "push: this server has no vpush, so no phone is woken: veydan-server add vpush" >&2
        fi
        printf '%s\n' "$link"
        ;;
    media-key)
        # Stored in server.conf; media takes it at the next run of the kit.
        case "${2:-}" in required|open) ;; *) die "veydan-server media-key required|open" ;; esac
        set_conf MEDIA_UPLOAD_KEY "$2"
        echo "media-key: $2 in $CONF; media takes it at the next run of the kit: veydan-server rerun" >&2
        ;;
    mode)
        # Stored in server.conf; vguard and nginx take it at the next run of
        # the kit. Without a word: the mode now.
        if [ -z "${2:-}" ]; then
            [ -r "$CONF" ] || die "no $CONF, or not readable: run install.sh once, as root"
            access_mode; echo
            exit 0
        fi
        case "$2" in open|team|channel) ;; *) die "veydan-server mode open|team|channel" ;; esac
        set_conf ACCESS_MODE "$2"
        echo "mode: $2 in $CONF; the relay takes it at the next run of the kit: veydan-server rerun" >&2
        if [ "$2" != open ]; then
            # shellcheck disable=SC1090
            admin=$( . "$CONF"; printf '%s' "${ADMIN_PUBKEY:-}" )
            [ -n "$admin" ] || echo "mode: $2 needs ADMIN_PUBKEY, your npub, in $CONF (the owner, always a member): set it before the rerun" >&2
            conf_has relay || echo "mode: this server has no relay; the mode is the relay's" >&2
        fi
        ;;
    invite)
        # An invite of vguard: a code that lets N people in for D days.
        need_access
        case "${2:-}" in
            list)
                guard invite list
                ;;
            revoke)
                [[ "${3:-}" =~ ^[A-Za-z0-9_-]{1,128}$ ]] || die "veydan-server invite revoke <id> (the id of veydan-server invite list)"
                guard invite revoke "$3"
                guard_reload
                ;;
            *)
                shift
                args=() uses=1 days=7
                while [ $# -gt 0 ]; do
                    case "$1" in
                        --uses) uses=${2:-}; [[ "$uses" =~ ^[0-9]{1,6}$ ]] && [ "$uses" -ge 1 ] || die "--uses: a number of people, 1 or more"; shift 2 ;;
                        --days) days=${2:-}; [[ "$days" =~ ^[0-9]{1,4}$ ]] && [ "$days" -ge 1 ] || die "--days: a number of days, 1 or more"; shift 2 ;;
                        --label) [[ "${2:-}" =~ ^[A-Za-z0-9._-]{1,64}$ ]] || die "--label: letters, digits, . _ - (up to 64)"; args+=(--label "$2"); shift 2 ;;
                        *) die "veydan-server invite [--uses N] [--days D] [--label L] | list | revoke <id>" ;;
                    esac
                done
                code=$(guard invite --uses "$uses" --days "$days" "${args[@]}" | tail -n1 | tr -d '[:space:]') || die "vguard made no invite"
                [[ "$code" =~ $invite_re ]] || die "vguard gave no invite code: $code"
                guard_reload
                link=$(server_link "$code") || exit 1
                echo "invite: $uses use(s), $days day(s); the code alone, for the app's \"Join by code\":" >&2
                echo "$code" >&2
                printf '%s\n' "$link"
                ;;
        esac
        ;;
    members)
        need_access
        case "${2:-}" in
            list)
                guard members list
                ;;
            add|remove)
                [[ "${3:-}" =~ $key_re ]] || die "veydan-server members $2 <npub|hex>: an npub or 64 hex digits, lowercase"
                guard members "$2" "$3"
                guard_reload
                ;;
            *)
                die "veydan-server members list | add <npub|hex> | remove <npub|hex>"
                ;;
        esac
        ;;
    upload-key)
        # The upload keys of the media site (templates/njs/upload.js): the
        # app of the owner makes them too, with the app key, as here. The
        # revocations are one file per pair, <label>.<pubkey>, holding the time.
        [ -r "$CONF" ] || die "no $CONF, or not readable: run install.sh once, as root"
        keys=$STATE/media-keys
        now=${VEYDAN_NOW:-$(date +%s)}   # VEYDAN_NOW: the tests
        pair() {
            [[ "${1:-}" =~ ^[0-9a-f]{1,64}$ ]] || die "the label is 1 to 64 hex digits, lowercase"
            [[ "${2:-}" =~ ^[0-9a-f]{64}$ ]] || die "the pubkey is 64 hex digits, lowercase (not an npub)"
        }
        case "${2:-}" in
            list)
                [ -d "$keys" ] || exit 0
                for f in "$keys"/*.*; do
                    [ -f "$f" ] || continue
                    name=$(basename "$f")
                    printf '%s %s revoked %s\n' "${name%%.*}" "${name#*.}" "$(date -u -d "@$(cat "$f")" '+%Y-%m-%d %H:%M UTC')"
                done
                ;;
            revoke)
                pair "${3:-}" "${4:-}"
                [ -d "$keys" ] && [ -w "$keys" ] || die "no $keys, or not writable: a server with media, as root"
                tmp=$(mktemp "$keys/.revoke.XXXXXX")
                printf '%s\n' "$now" > "$tmp"
                # nginx's workers read and replace it.
                [ "$(id -u)" != 0 ] || chown www-data:www-data "$tmp"
                chmod 0600 "$tmp"
                mv -f "$tmp" "$keys/$3.$4"
                # Revocations older than any key still alive (32 days).
                for f in "$keys"/*.*; do
                    if [ -f "$f" ] && [ "$(cat "$f")" -lt $((now - 32 * 86400)) ] 2>/dev/null; then rm -f "$f"; fi
                done
                echo "upload-key: the keys of $3 $4 made until now are refused" >&2
                ;;
            ""|-*)
                die "veydan-server upload-key <label> <pubkey> [days] | revoke <label> <pubkey> | list"
                ;;
            *)
                pair "$2" "${3:-}"
                days=${4:-30}
                [[ "$days" =~ ^[0-9]+$ ]] && [ "$days" -ge 1 ] && [ "$days" -le 31 ] || die "days: 1 to 31"
                (
                    # shellcheck disable=SC1090
                    . "$CONF"
                    [[ " ${COMPONENTS:-} " == *" media "* ]] && [ -n "${MEDIA_HOST:-}" ] || die "this server has no media"
                    [ -n "${MESH_APP_KEY:-}" ] || die "no MESH_APP_KEY in $CONF"
                    [ "${MEDIA_UPLOAD_KEY:-open}" = required ] \
                        || echo "upload-key: uploads here are open (MEDIA_UPLOAD_KEY=open); the key is needed once they are required" >&2
                    # The name of the media site, as on the card: lowercase, no port.
                    case "$MEDIA_HOST" in *.*) host=$MEDIA_HOST ;; *) host=$MEDIA_HOST.${BASE_DOMAIN:-} ;; esac
                    host=$(printf '%s' "$host" | tr '[:upper:]' '[:lower:]')
                    exp=$((now + days * 86400))
                    mac=$(printf 'veydan.media.upload.v1\n%s\n%s\n%s\n%s\n%s' "$host" "$2" "$3" "$now" "$exp" \
                        | openssl dgst -sha256 -hmac "$MESH_APP_KEY" | sed 's/.*= //' | cut -c1-32)
                    [[ "$mac" =~ ^[0-9a-f]{32}$ ]] || die "openssl gave no HMAC"
                    echo "upload-key: for https://$host until $(date -u -d "@$exp" '+%Y-%m-%d %H:%M UTC')" >&2
                    printf 'vu1.%s.%s.%s.%s.%s\n' "$2" "$3" "$now" "$exp" "$mac"
                )
                ;;
        esac
        ;;
    add)
        need_root
        [ -n "${2:-}" ] || die "veydan-server add relay|media|vpush|call"
        exec bash "$(kit)/run.sh" --add "$2" --yes
        ;;
    rerun)
        need_root
        exec bash "$(kit)/run.sh" --yes
        ;;
    status)
        # Every unit the kit keeps under /opt/<app>/etc, and nginx.
        units=""
        for f in /opt/*/etc/*.service /opt/*/etc/*.timer; do
            [ -f "$f" ] || continue
            u=$(basename "$f")
            # A service run by its timer is told by the timer.
            case "$u" in *.service) [ -f "${f%.service}.timer" ] && continue ;; esac
            units="$units $u"
        done
        units="$units nginx"
        # shellcheck disable=SC2086
        systemctl --no-pager status $units 2>/dev/null | grep -E '^[●○×x]|Active:' || true
        ;;
    *)
        # The usage: the head of this file.
        awk 'NR > 1 && /^#/ { print; next } NR > 1 { exit }' "$0" | sed 's/^# \{0,1\}//'
        exit 1
        ;;
esac
